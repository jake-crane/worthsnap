# Copy this file to secrets.properties (same directory) and fill in real values.
# secrets.properties is gitignored and loaded automatically by application.properties
# (spring.config.import=optional:file:./secrets.properties) - it's never committed and
# never touches your shell history.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
